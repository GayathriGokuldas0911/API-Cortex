# Application Configuration
APP_NAME="API Cortex"
APP_ENV="development"
DEBUG=True
PORT=8000

# PostgreSQL Database Configuration
# Replace YOUR_POSTGRES_USER, YOUR_POSTGRES_PASSWORD, YOUR_POSTGRES_HOST, YOUR_POSTGRES_PORT, YOUR_DB_NAME
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/api_cortex"

# Security & Authentication
SECRET_KEY="replace_with_a_secure_random_secret_key_for_jwt"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Google Gemini AI API Key
GEMINI_API_KEY="your_gemini_api_key_here"

# Prometheus Exporter Port
PROMETHEUS_METRICS_PATH="/metrics"
