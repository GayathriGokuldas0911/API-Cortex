{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "title": "API Request Rate (req/min)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "sum(rate(api_cortex_requests_total{project_id=\"$project_id\"}[$__rate_interval])) by (api_name) * 60",
          "legendFormat": "{{api_name}}",
          "range": true,
          "refId": "A"
        }
      ]
    },
    {
      "title": "API Response Latency (ms)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "(sum(rate(api_cortex_response_time_seconds_sum{project_id=\"$project_id\"}[$__rate_interval])) by (api_name) / sum(rate(api_cortex_response_time_seconds_count{project_id=\"$project_id\"}[$__rate_interval])) by (api_name)) * 1000",
          "legendFormat": "{{api_name}} Latency",
          "range": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        }
      }
    },
    {
      "title": "API Availability",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 8 },
      "id": 3,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "api_cortex_api_availability{project_id=\"$project_id\"} * 100",
          "legendFormat": "{{api_name}}",
          "range": false,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 100 }
            ]
          }
        }
      }
    },
    {
      "title": "Monitoring HTTP Error Rate (err/min)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 18, "x": 6, "y": 8 },
      "id": 4,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "sum(rate(api_cortex_errors_total{project_id=\"$project_id\"}[$__rate_interval])) by (api_name, issue_type) * 60",
          "legendFormat": "{{api_name}} ({{issue_type}})",
          "range": true,
          "refId": "A"
        }
      ]
    },
    {
      "title": "Total Checks vs Errors",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "id": 5,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "sum(rate(api_cortex_requests_total{project_id=\"$project_id\"}[$__rate_interval])) * 60",
          "legendFormat": "Total Checks",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "sum(rate(api_cortex_errors_total{project_id=\"$project_id\"}[$__rate_interval])) * 60",
          "legendFormat": "Errors",
          "range": true,
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 1,
            "stacking": { "mode": "normal", "group": "A" }
          },
          "color": { "mode": "palette-classic" }
        }
      }
    },
    {
      "title": "Healthy APIs",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 16 },
      "id": 6,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "count(api_cortex_api_availability{project_id=\"$project_id\"} == 1)",
          "legendFormat": "Healthy",
          "range": false,
          "refId": "A"
        }
      ]
    },
    {
      "title": "API Health Overview",
      "type": "bargauge",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 16 },
      "id": 7,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "api_cortex_api_availability{project_id=\"$project_id\"}",
          "legendFormat": "{{api_name}}",
          "range": false,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          },
          "max": 1,
          "min": 0
        }
      }
    },
    {
      "title": "Total Request Count",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 20 },
      "id": 8,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "sum(api_cortex_requests_total{project_id=\"$project_id\"})",
          "legendFormat": "Total Requests",
          "range": false,
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "5s",
